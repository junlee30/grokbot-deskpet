{
  "name": "grokbot-deskpet-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Desk Pet, for Grok Bot (unofficial) - desktop app frontend (Tauri v2 + Vite).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "art": "node ../scripts/import-grokbot-art.mjs",
    "prebuild": "node ../scripts/import-grokbot-art.mjs --quiet",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sprites": "node art/build-sprites.mjs",
    "tauri": "cargo tauri",
    "test": "node --test --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
