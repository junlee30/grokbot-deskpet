{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pets",
  "description": "One window per bot: drag the window and open http(s) links only.",
  "windows": ["pet-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
