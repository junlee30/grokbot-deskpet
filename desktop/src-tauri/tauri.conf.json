{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desk Pet",
  "version": "0.5.0",
  "identifier": "dev.deskpet.grokbot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Desk Pet",
        "width": 360,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "visible": false,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Desk Pet, for Grok Bot (unofficial)",
    "longDescription": "A pixel-art pet on your desktop for each of your Grok Bots. Unofficial; not affiliated with or endorsed by xAI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFQUNFMzlGQjZBNUM4OEIKUldTTHlLVzJuK09zN2h2TE1pM2NYMTRETHJqNWV0Nnh1VlR2OHdleGlCakduakwzR20zUUJZNjEK",
      "endpoints": [
        "https://github.com/junlee30/grokbot-deskpet/releases/latest/download/latest.json"
      ]
    }
  }
}
